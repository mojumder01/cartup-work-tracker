# Copy to .env for LOCAL testing only. .env is git-ignored. Never commit real values.
#
# In production these are GitHub Actions *secrets* (Settings -> Secrets and variables -> Actions):
#   GOOGLE_SERVICE_ACCOUNT_JSON  full contents of the service-account key file
#   GOOGLE_SHEET_ID              spreadsheet ID (or full URL)
#
# There are deliberately NO VITE_* variables: anything prefixed VITE_ is bundled into
# the public website, so credentials must never use that prefix.

# Spreadsheet ID from https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=1H35eZz06Wx4uGcFXxZjwQQ1F1M5T8qU3gi8fY2gvaXc

# Local runs: path to a key file kept OUTSIDE git (credentials/ is git-ignored)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# Alternatively paste the whole key JSON (single line) or its base64 encoding:
# GOOGLE_SERVICE_ACCOUNT_JSON=
