{
  "name": "cartup-content-work-tracker",
  "private": true,
  "version": "1.5.1",
  "type": "module",
  "description": "Cartup Content work performance dashboard (Google Sheets -> GitHub Actions -> GitHub Pages)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "fetch-data": "node scripts/fetch-sheets.mjs",
    "fetch-data:local": "node --env-file=.env scripts/fetch-sheets.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.2.0",
    "write-excel-file": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
